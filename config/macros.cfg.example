; Copy this file to macros.cfg and edit the steps.
; Only allowlisted actions, .exe/.lnk targets, http(s)/ms-settings URLs and bounded delays are accepted.
[meta]
version=1

[macro1]
name=Preparar transmissão
step_count=3
step1=action:volume_down
step2=open:obs64.exe
step3=delay:500

[macro2]
name=Alternar cena de trabalho
step_count=2
step1=action:audio_mute
step2=open:calc.exe
